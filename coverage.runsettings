<RunSettings>
  <DataCollectionRunSettings><DataCollectors><DataCollector friendlyName="XPlat Code Coverage"><Configuration>
    <Format>cobertura</Format>
    <Include>[Auth.*]*,[Account.*]*,[Message.*]*,[BuildingBlocks]*,[Contracts]*,[Gateway]*</Include>
    <ExcludeByFile>**/Migrations/*.cs,**/obj/**/*.cs</ExcludeByFile>
    <SingleHit>false</SingleHit>
  </Configuration></DataCollector></DataCollectors></DataCollectionRunSettings>
</RunSettings>
