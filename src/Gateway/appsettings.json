{
  "ReverseProxy": {
    "Routes": {
      "auth": { "ClusterId": "auth", "Match": { "Path": "/api/v1/auth/{**rest}" } },
      "account": { "ClusterId": "account", "AuthorizationPolicy": "default", "Match": { "Path": "/api/v1/accounts/{**rest}" } },
      "message": { "ClusterId": "message", "AuthorizationPolicy": "default", "Match": { "Path": "/api/v1/chat/{**rest}" } },
      "hub": { "ClusterId": "message", "AuthorizationPolicy": "default", "Match": { "Path": "/hubs/chat/{**rest}" } },
      "auth-docs": { "ClusterId": "auth", "Match": { "Path": "/openapi/auth/v1.json" }, "Transforms": [{ "PathSet": "/openapi/v1.json" }] },
      "account-docs": { "ClusterId": "account", "Match": { "Path": "/openapi/account/v1.json" }, "Transforms": [{ "PathSet": "/openapi/v1.json" }] },
      "message-docs": { "ClusterId": "message", "Match": { "Path": "/openapi/message/v1.json" }, "Transforms": [{ "PathSet": "/openapi/v1.json" }] },
      "assets": { "ClusterId": "web", "Match": { "Path": "/assets/{**rest}" } },
      "chat-web": { "ClusterId": "web", "Match": { "Path": "/chat/{**rest}" } },
      "admin-web": { "ClusterId": "web", "Match": { "Path": "/admin/{**rest}" } },
      "auth-web": { "ClusterId": "web", "Match": { "Path": "/auth/{**rest}" } },
      "root": { "ClusterId": "web", "Match": { "Path": "/" } },
      "favicon": { "ClusterId": "web", "Match": { "Path": "/favicon.svg" } }
    },
    "Clusters": {
      "auth": { "Destinations": { "one": { "Address": "http://auth:8080" } } },
      "account": { "Destinations": { "one": { "Address": "http://account:8080" } } },
      "message": { "SessionAffinity": { "Enabled": true, "Policy": "HashCookie", "FailurePolicy": "Redistribute", "AffinityKeyName": "chat-affinity" }, "Destinations": { "one": { "Address": "http://message:8080" } } },
      "web": { "Destinations": { "one": { "Address": "http://web:8080" } } }
    }
  }
}
