        ],
        "產出": [
          "ADR、UML／資料關聯、同步／非同步與失敗處理；需 POC 者列證據計畫。"
        ],
        "完成條件": [
          "理由、代價與重評條件可查；替代方案若未實測必須標示，不補造歷史會議。"
        ],
        "責任角色": [
          "技術設計角色（待具名）。"
        ]
      }
    },
    {
      "id": "PHASE-03",
      "title": "«activity» 驗收定義",
      "document": "09-agent-maintenance.misvg.svg",
      "fields": {
        "輸入": [
          "REQ、風險與獨立預期依據；先確認如何判定完成。"
        ],
        "產出": [
          "AC 的 Given／When／Then、測試參照、命令及所需環境。"
        ],
        "完成條件": [
          "重要權限、資料完整性與失敗情境均有驗證方式；參照完整不等於已通過驗收。"
        ],
        "責任角色": [
          "需求／測試角色（待具名）；不以 TDD 或覆蓋率取代產品驗收。"
        ]
      }
    },
    {
      "id": "PHASE-04",
      "title": "«activity» 小步開發",
      "document": "09-agent-maintenance.misvg.svg",
      "fields": {
        "輸入": [
          "一個可回復的小任務、允許修改範圍、契約與回歸條件。"
        ],
        "產出": [
          "可審查變更、受影響 REQ／ADR／圖頁與相關測試結果。"
        ],
        "完成條件": [
          "相關格式、型別、建置與測試通過；共用模組、資料遷移或介面變更須重評影響。"
        ],
        "責任角色": [
          "實作／審查角色（待具名）；依既有授權推進，不新增無依據的批准流程。"
        ]
      }
    },
    {
      "id": "PHASE-05",
      "title": "«activity» 可靠度驗證",
      "document": "09-agent-maintenance.misvg.svg",
      "fields": {
        "輸入": [
          "風險分級、測試計畫、版本與隔離環境。"
        ],
        "產出": [
          "命令、環境、時間、pass／fail／skipped／not-run 與原始證據。"
        ],
        "完成條件": [
          "正常、異常、邊界及部署情境依風險驗證；本次文件變更不擴張成應用程式重新驗收。"
        ],
        "責任角色": [
          "測試／維運角色（待具名）；效能、安全深度與恢復演練依目標安排。"
        ],
        "歷史證據": [
          "HIST-CI-46FB1E2；commit 46fb1e21eae8d40d59309cc405b3d77ae5d0b190；GitHub Actions 42389347629／attempt 1。"
        ]
      }
    },
    {
      "id": "PHASE-06",
      "title": "«activity» 交付與交接",
      "document": "09-agent-maintenance.misvg.svg",
      "fields": {
        "輸入": [
          "適用版本文件、驗收證據、部署與故障手冊、已知限制。"
        ],
        "產出": [
          "當前文件索引＋唯增封存紀錄；更正須另建紀錄並連回原文。"
        ],
        "完成條件": [
          "有啟動前置條件、成功判據、失敗處理及維護入口；未參與者演練／第二模型檢查未做則列 not-run。"
        ],
        "責任角色": [
          "交付／接手維護角色（待具名）；目前沒有冒認人工核准。"
        ],
        "交接 Q-H01": [
          "外部服務與權責？查 00 的服務／資料資源節點；三組 PG／Redis、RabbitMQ、Garage 與 SMTP。"
        ],
        "交接 Q-H02": [
          "如何啟動成功？根 README 的 init.sh／Compose；wait-containers.py --all 檢查健康。"
        ],
        "交接 Q-H03": [
          "MQ 中斷怎麼辦？05 的 Outbox 保留已提交資料、恢復補送；授權撤銷看 06。"
        ],
        "交接 Q-H04": [
          "需求對應測試？先查 catalog 的 REQ／驗收／測試參照，再核對封存版本與原始輸出。"
        ],
        "交接 Q-H05": [
          "何時人工介入？死信修正重送、金鑰輪替、備份還原；查 docs/operations.md。"
        ]
      }
